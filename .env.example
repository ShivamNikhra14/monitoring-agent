# ══════════════════════════════════════════════════════════════════════════════
# Monitoring Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported: ollama (default, local)  |  openai (cloud)
LLM_PROVIDER=ollama

# Model name:
#   Ollama:  any model you have pulled  (ollama pull llama3.1:8b)
#   OpenAI:  gpt-4o-mini, gpt-4o, gpt-3.5-turbo, …
LLM_MODEL=llama3.1:8b

# ── Ollama settings (only used when LLM_PROVIDER=ollama) ─────────────────────
# URL of your local Ollama server.
# Default works if Ollama is running on the same machine.
# Change to e.g. http://192.168.1.10:11434 for a remote Ollama host.
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI settings (only used when LLM_PROVIDER=openai) ─────────────────────
# Your OpenAI API key — required only when LLM_PROVIDER=openai.
# OPENAI_API_KEY=sk-...

# Optional: override the OpenAI API base URL.
# Use this for Azure OpenAI, a custom proxy, or any OpenAI-compatible server.
# Leave blank to use the official OpenAI endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Log source ────────────────────────────────────────────────────────────────
LOG_FILE_PATH=sample_logs/application.log

# ── Correlation / grouping ────────────────────────────────────────────────────
# How close in time (seconds) two events must be to be grouped together.
CORRELATION_WINDOW_SECONDS=5
# How long (seconds) to wait after the last event before flushing a cluster.
FLUSH_DELAY_SECONDS=3

# ── Deduplication ─────────────────────────────────────────────────────────────
# Suppress duplicate alerts for this many hours.
DEDUP_WINDOW_HOURS=10
# Path to the SQLite state database.
STATE_DB_PATH=monitoring_state.db

# ── Custom triage rules (optional) ───────────────────────────────────────────
# Comma-separated codebase-specific rules injected into the triage prompt.
# Example:
# CUSTOM_TRIAGE_RULES=In this system /healthz always returns 200 during deploys.,Database pool exhaustion at startup is expected and non-actionable.
